{
  "name": "Barbearia-dashboard",
  "version": "2.0.0",
  "description": "Projeto de dashboard e chatbot para negócios locais, com agenda, clientes, serviços e atendimento pelo WhatsApp",
  "main": "api.js",
  "scripts": {
    "start": "node api.js",
    "dev": "nodemon api.js",
    "supervise": "node scripts/supervisor.js",
    "smoke:local": "node scripts/local-smoke.js",
    "test": "node --test tests/*.test.js",
    "release:client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "test:live": "set RUN_LIVE_API_TESTS=1&& node --test tests/*.test.js"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "morgan": "^1.11.0",
    "node-fetch": "^2.7.0"
  },
  "overrides": {
    "qs": "^6.15.3",
    "ws": "^7.5.11"
  }
}
